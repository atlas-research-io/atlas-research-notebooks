# Atlas Research Notebooks - Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Federal Reserve Economic Data (FRED) API
# Used by: economics/001_fred_data.py, economics/003_central_banking_asset_growth.py
# Get your free key at: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Note: Most notebooks use free public APIs that require no keys:
#   - Crypto notebooks use CCXT (public exchange endpoints)
#   - Geography notebooks use World Bank API (free, no key needed)
#   - Economics/002 uses Yahoo Finance (free, no key needed)
